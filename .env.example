# Firebase Console > 프로젝트 설정 > 일반 > 내 앱 > 웹 앱의 firebaseConfig 값을 복사하세요.
# 실제 값은 .env.local에 입력하고 Vite 개발 서버를 다시 시작하세요.
# 필수: API_KEY, AUTH_DOMAIN, PROJECT_ID, APP_ID
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Analytics를 사용하지 않으면 비워 두어도 됩니다.
VITE_FIREBASE_MEASUREMENT_ID=

# VITE_ 변수는 브라우저에 포함되는 Firebase 웹 앱 설정입니다.
# 서비스 계정 비공개 키나 OpenAI API Key는 여기에 넣지 마세요.
# Authentication > 설정 > 승인된 도메인에 실제 접속 호스트를 등록하세요.
# 예: localhost, 127.0.0.1, 실제 배포 도메인 (프로토콜과 포트 제외)

# 교사 모니터링 접근을 허용할 Firebase Authentication UID 목록
# 쉼표로 구분합니다. 예: VITE_ADMIN_UIDS=첫번째_UID,두번째_UID
# 비워 두면 아무도 교사 페이지에 접근할 수 없습니다.
# 변경 후 개발 서버를 다시 시작하고, 배포 시에는 다시 빌드하세요.
VITE_ADMIN_UIDS=
